<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="build/phpunit"
         executionOrder="random"
         resolveDependencies="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnPhpunitDeprecations="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Fixtures">
            <directory>tests/Fixture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <!--
            The whole suite runs with the non-convergence invariant armed: a
            function whose taint fixed point does not settle throws instead of
            warning, naming the operand two ops disagree on. Every fixture
            converges today, so this is a tripwire for the day a change
            reintroduces the oscillation this project has hit six times.
        -->
        <env name="WP_TAINT_DEBUG" value="1"/>
    </php>
</phpunit>
